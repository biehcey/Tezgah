{
  "name": "tezgah-db",
  "version": "0.2.2",
  "description": "PostgreSQL için kişisel, yerel çalışan bir veritabanı yönetim aracı",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biehcey/tezgah-db.git"
  },
  "bin": {
    "tezgah-db": "dist/server/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/cli.ts --port 5174 --dev-web-port 5173 --no-open",
    "dev:web": "vite",
    "build": "vite build && tsup",
    "start": "node dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.server.json && tsc -p tsconfig.web.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:pg": "tsx scripts/test-pg.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2",
    "fast-xml-parser": "~5.11.2",
    "pg": "^8.23.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "~1.17.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
